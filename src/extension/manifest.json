{
    "manifest_version": 3,
    "name": "Copyright Bypass Skip",
    "version": "{{VERSION}}",
    "description": "Skips the silence some SoundCloud uploads add to bypass copyright detection.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Copyright Bypass Skip",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["https://soundcloud.com/*"],
            "js": ["page.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://soundcloud.com/*"],
            "js": ["settings.js", "bridge.js"],
            "run_at": "document_start"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "copyright-bypass-skip@foidtech",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
